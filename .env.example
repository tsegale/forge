# Copy to .env and replace every value. Never commit .env.
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forge
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_urlsafe-64
# Signs access and refresh tokens. At least 32 bytes; generate it the same way, never reuse SECRET_KEY.
JWT_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_urlsafe-64
# Stripe (Dashboard > Developers > API keys). Use test-mode keys (sk_test_...) outside production;
# live keys are refused unless FORGE_ENV=production. The webhook secret comes from the endpoint
# you register for /api/v1/webhooks/stripe, or from `stripe listen` during development.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# Public by design: served to the browser by GET /api/v1/config for Stripe.js.
STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
# Outgoing email (order confirmations). Required in production. With docker-compose.dev.yml these
# are overridden to send to Mailpit; view caught mail at http://127.0.0.1:8025.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Forge <orders@example.com>
# The public address of the store, for links in emails (password reset). Required in production.
PUBLIC_BASE_URL=https://forge.example.com
STORE_CURRENCY=nad
FORGE_ENV=production
HTTP_PORT=8080
